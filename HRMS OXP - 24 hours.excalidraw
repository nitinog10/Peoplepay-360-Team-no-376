    {
      "type": "text",
      "version": 812,
      "versionNonce": 1031908388,
      "isDeleted": false,
      "id": "GgJGlrQx9V1Ti32GssCgg",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 2614.5552221456514,
      "y": 5940.479102808655,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
