# Server
NODE_ENV=development
PORT=8000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# Database (MySQL 8). Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:root@localhost:3306/peoplepay360"

# Auth
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false

# Business configuration (nothing is hardcoded in the app)
DEFAULT_CURRENCY=INR
APP_TIMEZONE=Asia/Kolkata
LATE_GRACE_MINUTES=10

# Payroll mail. Leave SMTP_HOST blank to use deterministic JSON transport locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PeoplePay360 Payroll <payroll@peoplepay.local>

# Seed accounts created by `prisma db seed`
SEED_HR_USERNAME=hr.manager
SEED_HR_PASSWORD=ChangeMe123!
SEED_EMPLOYEE_PASSWORD=Employee123!
SEED_PAYROLL_PASSWORD=Payroll123!
SEED_PAYROLL_MANAGER_PASSWORD=PayrollManager123!
