// PeoplePay360 — Phase 1–3 schema (team SQL plus provisional payroll schema translated to MySQL/Prisma).
// Table and column names are kept snake_case in MySQL via @map/@@map.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
  // Prisma 6.19.3 (pinned) reads the connection string from the schema, not from
  // prisma.config.ts — that config-level `datasource` override needs Prisma 7.
  // The runtime pool still parses DATABASE_URL itself in src/lib/prisma.ts.
  url      = env("DATABASE_URL")
}

// ---------- Enums (PostgreSQL CHECK constraints → MySQL ENUM) ----------

enum RoleName {
  EMPLOYEE
  HR_MANAGER
  HR_PAYROLL_USER
  HR_PAYROLL_MANAGER
  ADMIN
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum ContractType {
  PERMANENT
  FIXED_TERM
  INTERNSHIP
  CONTRACTOR
}

enum ContractStatus {
  ACTIVE
  EXPIRED
  TERMINATED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  HOLIDAY
  WEEK_OFF
}

enum AttendanceEntryType {
  CLOCK_IN
  CLOCK_OUT
  BREAK_START
  BREAK_END
}

enum AttendanceSource {
  MANUAL
  BIOMETRIC
  MOBILE_APP
  WEB
}

enum TimeOffStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

enum SalaryRuleCategory {
  BASIC
  ALLOWANCE
  GROSS
  DEDUCTION
  NET
}

enum SalaryRuleMethod {
  FIXED
  PERCENTAGE
  FORMULA
}

enum SalaryRuleBase {
  CONTRACT_WAGE
  BASIC
  GROSS
}

enum PayrunStatus {
  DRAFT
  COMPUTED
  VALIDATED
  PAID
  CANCELLED
}

// ---------- Reference / Lookup Tables ----------

model Role {
  roleId   Int      @id @default(autoincrement()) @map("role_id")
  roleName RoleName @unique @map("role_name")

  users User[]

  @@map("roles")
}

model Department {
  departmentId   Int     @id @default(autoincrement()) @map("department_id")
  departmentName String  @unique @map("department_name") @db.VarChar(100)
  description    String? @db.Text

  employees Employee[]

  @@map("departments")
}

model LeaveType {
  leaveTypeId       Int     @id @default(autoincrement()) @map("leave_type_id")
  typeName          String  @unique @map("type_name") @db.VarChar(50)
  defaultAnnualDays Decimal @default(0) @map("default_annual_days") @db.Decimal(5, 2)
  description       String? @db.Text

  leaveBalances   LeaveBalance[]
  timeOffRequests TimeOffRequest[]

  @@map("leave_types")
}

model WorkSchedule {
  scheduleId   Int      @id @default(autoincrement()) @map("schedule_id")
  scheduleName String   @unique @map("schedule_name") @db.VarChar(100)
  /// ISO weekdays as a JSON array, e.g. [1,2,3,4,5]. (MySQL has no array type.)
  daysOfWeek   Json     @map("days_of_week")
  startTime    DateTime @map("start_time") @db.Time(0)
  endTime      DateTime @map("end_time") @db.Time(0)
  /// Derived: |daysOfWeek| × (endTime − startTime). Recomputed by the service on save.
  weeklyHours  Decimal? @map("weekly_hours") @db.Decimal(4, 2)
  description  String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  assignments EmployeeScheduleAssignment[]

  @@map("work_schedules")
}

// ---------- Core People Tables ----------

model Employee {
  employeeId      Int            @id @default(autoincrement()) @map("employee_id")
  firstName       String         @map("first_name") @db.VarChar(50)
  lastName        String         @map("last_name") @db.VarChar(50)
  email           String         @unique @db.VarChar(150)
  phone           String?        @db.VarChar(20)
  dateOfBirth     DateTime?      @map("date_of_birth") @db.Date
  address         String?        @db.Text
  hireDate        DateTime       @map("hire_date") @db.Date
  terminationDate DateTime?      @map("termination_date") @db.Date
  departmentId    Int?           @map("department_id")
  jobTitle        String?        @map("job_title") @db.VarChar(100)
  managerId       Int?           @map("manager_id")
  status          EmployeeStatus @default(ACTIVE)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at")

  department Department? @relation(fields: [departmentId], references: [departmentId])
  manager    Employee?   @relation("EmployeeManager", fields: [managerId], references: [employeeId])
  reports    Employee[]  @relation("EmployeeManager")

  user                User?
  contracts           Contract[]                   @relation("EmployeeContracts")
  createdContracts    Contract[]                   @relation("ContractCreatedBy")
  scheduleAssignments EmployeeScheduleAssignment[]
  leaveBalances       LeaveBalance[]
  attendanceRecords   AttendanceRecord[]
  timeOffRequests     TimeOffRequest[]
  reviewedApprovals   TimeOffApproval[]            @relation("ApprovalReviewer")
  bankDetail          EmployeeBankDetail?
  payslips            Payslip[]
  createdPayruns      Payrun[]                     @relation("PayrunCreatedBy")
  validatedPayruns    Payrun[]                     @relation("PayrunValidatedBy")
  paidPayruns         Payrun[]                     @relation("PayrunPaidBy")
  cancelledPayruns    Payrun[]                     @relation("PayrunCancelledBy")

  @@index([departmentId], map: "idx_employees_department")
  @@index([managerId], map: "idx_employees_manager")
  @@map("employees")
}

/// Authentication / authorization, kept separate from personal data.
model User {
  userId       Int       @id @default(autoincrement()) @map("user_id")
  employeeId   Int       @unique @map("employee_id")
  username     String    @unique @db.VarChar(50)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  roleId       Int       @map("role_id")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  employee      Employee       @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  role          Role           @relation(fields: [roleId], references: [roleId])
  refreshTokens RefreshToken[]

  @@map("users")
}

/// Added for session handling (not in the original team schema).
model RefreshToken {
  tokenId   Int       @id @default(autoincrement()) @map("token_id")
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId], map: "idx_refresh_tokens_user")
  @@map("refresh_tokens")
}

// ---------- Contracts (HR Manager: CRUD) ----------

model Contract {
  contractId   Int            @id @default(autoincrement()) @map("contract_id")
  employeeId   Int            @map("employee_id")
  contractType ContractType   @map("contract_type")
  startDate    DateTime       @map("start_date") @db.Date
  endDate      DateTime?      @map("end_date") @db.Date
  baseSalary   Decimal?       @map("base_salary") @db.Decimal(12, 2)
  /// Default comes from DEFAULT_CURRENCY in the environment (set by the service).
  currency     String?        @db.VarChar(3)
  status       ContractStatus @default(ACTIVE)
  documentUrl  String?        @map("document_url") @db.Text
  createdBy    Int?           @map("created_by")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at")

  employee Employee  @relation("EmployeeContracts", fields: [employeeId], references: [employeeId], onDelete: Cascade)
  creator  Employee? @relation("ContractCreatedBy", fields: [createdBy], references: [employeeId])
  payslips Payslip[]

  @@index([employeeId], map: "idx_contracts_employee")
  @@index([employeeId, status], map: "idx_contracts_employee_status")
  @@map("contracts")
}

// ---------- Working Schedules (HR Manager: CRUD | Employee: read own) ----------

model EmployeeScheduleAssignment {
  assignmentId  Int       @id @default(autoincrement()) @map("assignment_id")
  employeeId    Int       @map("employee_id")
  scheduleId    Int       @map("schedule_id")
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at")

  employee Employee     @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  schedule WorkSchedule @relation(fields: [scheduleId], references: [scheduleId])

  @@unique([employeeId, effectiveFrom], map: "uq_schedule_assignment_employee_from")
  @@index([employeeId], map: "idx_schedule_assignments_employee")
  @@map("employee_schedule_assignments")
}

// ---------- Leave Balances (Employee: read own | HR Manager: CRUD) ----------

model LeaveBalance {
  leaveBalanceId     Int      @id @default(autoincrement()) @map("leave_balance_id")
  employeeId         Int      @map("employee_id")
  leaveTypeId        Int      @map("leave_type_id")
  year               Int      @db.SmallInt
  allocatedDays      Decimal  @default(0) @map("allocated_days") @db.Decimal(5, 2)
  carriedForwardDays Decimal  @default(0) @map("carried_forward_days") @db.Decimal(5, 2)
  usedDays           Decimal  @default(0) @map("used_days") @db.Decimal(5, 2)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  employee  Employee  @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [leaveTypeId])

  // remaining_days = allocated_days + carried_forward_days - used_days (derived in the API, never stored)
  @@unique([employeeId, leaveTypeId, year], map: "uq_leave_balance_employee_type_year")
  @@index([employeeId, year], map: "idx_leave_balances_employee_year")
  @@map("leave_balances")
}

// ---------- Attendance (Employee: punch + read own | HR Manager: CRUD) ----------

model AttendanceRecord {
  attendanceRecordId Int              @id @default(autoincrement()) @map("attendance_record_id")
  employeeId         Int              @map("employee_id")
  attendanceDate     DateTime         @map("attendance_date") @db.Date
  status             AttendanceStatus @default(PRESENT)
  notes              String?          @db.Text
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at")

  employee Employee          @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  entries  AttendanceEntry[]

  @@unique([employeeId, attendanceDate], map: "uq_attendance_employee_date")
  @@index([employeeId, attendanceDate], map: "idx_attendance_records_emp_date")
  @@map("attendance_records")
}

model AttendanceEntry {
  attendanceEntryId  Int                 @id @default(autoincrement()) @map("attendance_entry_id")
  attendanceRecordId Int                 @map("attendance_record_id")
  entryType          AttendanceEntryType @map("entry_type")
  entryTime          DateTime            @map("entry_time")
  source             AttendanceSource    @default(MANUAL)
  createdAt          DateTime            @default(now()) @map("created_at")

  record AttendanceRecord @relation(fields: [attendanceRecordId], references: [attendanceRecordId], onDelete: Cascade)

  // total hours worked per day: derived from paired CLOCK_IN / CLOCK_OUT entries minus breaks
  @@index([attendanceRecordId], map: "idx_attendance_entries_record")
  @@map("attendance_entries")
}

// ---------- Time Off Requests (Employee: CRUD own) ----------

model TimeOffRequest {
  timeOffRequestId Int           @id @default(autoincrement()) @map("time_off_request_id")
  employeeId       Int           @map("employee_id")
  leaveTypeId      Int           @map("leave_type_id")
  startDate        DateTime      @map("start_date") @db.Date
  endDate          DateTime      @map("end_date") @db.Date
  /// Computed by the service from the employee's working schedule.
  totalDays        Decimal       @map("total_days") @db.Decimal(5, 2)
  reason           String?       @db.Text
  status           TimeOffStatus @default(PENDING)
  requestedAt      DateTime      @default(now()) @map("requested_at")
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at")

  employee  Employee         @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  leaveType LeaveType        @relation(fields: [leaveTypeId], references: [leaveTypeId])
  approval  TimeOffApproval?

  // CHECK (end_date >= start_date) enforced in validation + service
  @@index([employeeId], map: "idx_time_off_requests_employee")
  @@index([status], map: "idx_time_off_requests_status")
  @@map("time_off_requests")
}

// ---------- Time Off Approvals (HR Manager only) ----------

model TimeOffApproval {
  approvalId       Int              @id @default(autoincrement()) @map("approval_id")
  timeOffRequestId Int              @unique @map("time_off_request_id")
  /// Must hold an HR-capable role (enforced by the service).
  reviewedBy       Int              @map("reviewed_by")
  decision         ApprovalDecision
  comments         String?          @db.Text
  decidedAt        DateTime         @default(now()) @map("decided_at")

  request  TimeOffRequest @relation(fields: [timeOffRequestId], references: [timeOffRequestId], onDelete: Cascade)
  reviewer Employee       @relation("ApprovalReviewer", fields: [reviewedBy], references: [employeeId])

  @@map("time_off_approvals")
}

// ---------- Phase 3 Payroll Configuration (read-only until Phase 4) ----------

model SalaryStructure {
  salaryStructureId Int      @id @default(autoincrement()) @map("salary_structure_id")
  name              String   @unique @db.VarChar(120)
  description       String?  @db.Text
  currency          String   @db.Char(3)
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  rules   SalaryRule[]
  payruns Payrun[]

  @@map("salary_structures")
}

model SalaryRule {
  salaryRuleId     Int                @id @default(autoincrement()) @map("salary_rule_id")
  salaryStructureId Int              @map("salary_structure_id")
  name             String             @db.VarChar(120)
  code             String             @unique @db.VarChar(50)
  category         SalaryRuleCategory
  sequence         Int
  method           SalaryRuleMethod
  fixedAmount      Decimal?           @map("fixed_amount") @db.Decimal(12, 2)
  percentage       Decimal?           @db.Decimal(7, 4)
  percentageBase   SalaryRuleBase?    @map("percentage_base")
  formula          String?            @db.Text
  isActive         Boolean            @default(true) @map("is_active")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at")

  salaryStructure SalaryStructure @relation(fields: [salaryStructureId], references: [salaryStructureId], onDelete: Restrict)
  payslipLines     PayslipLine[]

  @@unique([salaryStructureId, sequence], map: "uq_salary_rules_structure_sequence")
  @@index([salaryStructureId, isActive], map: "idx_salary_rules_structure_active")
  @@index([category], map: "idx_salary_rules_category")
  @@map("salary_rules")
}

model EmployeeBankDetail {
  employeeBankDetailId Int      @id @default(autoincrement()) @map("employee_bank_detail_id")
  employeeId           Int      @unique @map("employee_id")
  accountHolderName    String   @map("account_holder_name") @db.VarChar(150)
  bankName             String   @map("bank_name") @db.VarChar(150)
  accountNumber        String   @map("account_number") @db.VarChar(64)
  routingCode          String   @map("routing_code") @db.VarChar(64)
  branchName           String?  @map("branch_name") @db.VarChar(150)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)

  @@map("employee_bank_details")
}

// ---------- Phase 3 Payroll Runs and History ----------

model Payrun {
  payrunId          Int          @id @default(autoincrement()) @map("payrun_id")
  salaryStructureId Int          @map("salary_structure_id")
  name              String       @db.VarChar(150)
  periodStart       DateTime     @map("period_start") @db.Date
  periodEnd         DateTime     @map("period_end") @db.Date
  currency          String       @db.Char(3)
  status            PayrunStatus @default(DRAFT)
  createdBy         Int          @map("created_by")
  computedAt        DateTime?    @map("computed_at")
  validatedBy       Int?         @map("validated_by")
  validatedAt       DateTime?    @map("validated_at")
  paidBy            Int?         @map("paid_by")
  paidAt            DateTime?    @map("paid_at")
  cancelledBy       Int?         @map("cancelled_by")
  cancelledAt       DateTime?    @map("cancelled_at")
  cancelReason      String?      @map("cancel_reason") @db.VarChar(500)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at")

  salaryStructure SalaryStructure @relation(fields: [salaryStructureId], references: [salaryStructureId], onDelete: Restrict)
  creator         Employee        @relation("PayrunCreatedBy", fields: [createdBy], references: [employeeId], onDelete: Restrict)
  validator       Employee?       @relation("PayrunValidatedBy", fields: [validatedBy], references: [employeeId], onDelete: Restrict)
  payer           Employee?       @relation("PayrunPaidBy", fields: [paidBy], references: [employeeId], onDelete: Restrict)
  canceller       Employee?       @relation("PayrunCancelledBy", fields: [cancelledBy], references: [employeeId], onDelete: Restrict)
  payslips        Payslip[]

  @@index([status, periodStart, periodEnd], map: "idx_payruns_status_period")
  @@index([salaryStructureId], map: "idx_payruns_structure")
  @@index([createdBy], map: "idx_payruns_created_by")
  @@index([validatedBy], map: "idx_payruns_validated_by")
  @@index([paidBy], map: "idx_payruns_paid_by")
  @@index([cancelledBy], map: "idx_payruns_cancelled_by")
  @@map("payruns")
}

model Payslip {
  payslipId    Int      @id @default(autoincrement()) @map("payslip_id")
  payrunId     Int      @map("payrun_id")
  employeeId   Int      @map("employee_id")
  contractId   Int      @map("contract_id")
  contractWage Decimal  @map("contract_wage") @db.Decimal(12, 2)
  currency     String   @db.Char(3)
  expectedDays Decimal  @default(0) @map("expected_days") @db.Decimal(7, 2)
  workedDays   Decimal  @default(0) @map("worked_days") @db.Decimal(7, 2)
  unpaidDays   Decimal  @default(0) @map("unpaid_days") @db.Decimal(7, 2)
  expectedHours Decimal @default(0) @map("expected_hours") @db.Decimal(9, 2)
  workedHours  Decimal  @default(0) @map("worked_hours") @db.Decimal(9, 2)
  basic        Decimal  @default(0) @db.Decimal(12, 2)
  allowances   Decimal  @default(0) @db.Decimal(12, 2)
  gross        Decimal  @default(0) @db.Decimal(12, 2)
  deductions   Decimal  @default(0) @db.Decimal(12, 2)
  net          Decimal  @default(0) @db.Decimal(12, 2)
  computedAt   DateTime? @map("computed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  payrun   Payrun        @relation(fields: [payrunId], references: [payrunId], onDelete: Cascade)
  employee Employee      @relation(fields: [employeeId], references: [employeeId], onDelete: Restrict)
  contract Contract      @relation(fields: [contractId], references: [contractId], onDelete: Restrict)
  lines    PayslipLine[]

  @@unique([payrunId, employeeId], map: "uq_payslips_payrun_employee")
  @@index([employeeId], map: "idx_payslips_employee")
  @@index([contractId], map: "idx_payslips_contract")
  @@index([computedAt], map: "idx_payslips_computed_at")
  @@map("payslips")
}

model PayslipLine {
  payslipLineId Int                @id @default(autoincrement()) @map("payslip_line_id")
  payslipId     Int                @map("payslip_id")
  salaryRuleId  Int                @map("salary_rule_id")
  ruleName      String             @map("rule_name") @db.VarChar(120)
  ruleCode      String             @map("rule_code") @db.VarChar(50)
  category      SalaryRuleCategory
  sequence      Int
  method        SalaryRuleMethod
  fixedAmount   Decimal?           @map("fixed_amount") @db.Decimal(12, 2)
  percentage    Decimal?           @db.Decimal(7, 4)
  percentageBase SalaryRuleBase?   @map("percentage_base")
  formula       String?            @db.Text
  amount        Decimal            @db.Decimal(12, 2)
  createdAt     DateTime           @default(now()) @map("created_at")

  payslip    Payslip    @relation(fields: [payslipId], references: [payslipId], onDelete: Cascade)
  salaryRule SalaryRule @relation(fields: [salaryRuleId], references: [salaryRuleId], onDelete: Restrict)

  @@unique([payslipId, sequence], map: "uq_payslip_lines_payslip_sequence")
  @@unique([payslipId, salaryRuleId], map: "uq_payslip_lines_payslip_rule")
  @@index([salaryRuleId], map: "idx_payslip_lines_rule")
  @@index([payslipId, category], map: "idx_payslip_lines_payslip_category")
  @@map("payslip_lines")
}
